{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nodemon", "--watch", "API/src", "API/src/server.js"],
      "port": 5000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "app-web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--bind", "127.0.0.1", "--directory", "app/build/web"],
      "port": 8090
    }
  ]
}
